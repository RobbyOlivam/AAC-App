<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer everything except the private usage log. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="usage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="usage/" />
    </device-transfer>
</data-extraction-rules>
